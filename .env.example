# .env.example — template only. Real keys come from the MILMED iMac's existing storage.
# Copy to .env (gitignored) only if you need to override discovery.
# The app checks, in order: .env → shell profile (~/.zshrc) → macOS Keychain.

# LLM scoring (Phase 2) — one of these
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Jev decision model (Phase 2, optional — rule-based scoring works without it)
# JEV_API_KEY=

# Database (local Postgres on the iMac)
DATABASE_URL=postgresql://localhost:5432/milmed

# Redis (local)
REDIS_URL=redis://localhost:6379

# Crawler behavior
MTEC_RATE_LIMIT_SECONDS=2
USER_AGENT=MILMED-Connect-Bot/0.1 (+https://github.com/seantei/milmed-connect)

# Alerts (optional)
# SLACK_WEBHOOK_URL=
# SMTP_HOST=