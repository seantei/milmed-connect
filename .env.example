# .env.example — template only. Real keys come from the MILMED iMac's existing storage.
# Copy to .env (gitignored) only if you need to override discovery.
# Discovery is explicit and project-specific. See docs/DEPLOYMENT.md and docs/API_KEY_CHECK.md.

# LLM scoring (Phase 2, optional — rules-only path works without it)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Jev / TypeSafe decision model (Phase 2, optional)
# Official SDK reads TYPESAFE_API_KEY
# TYPESAFE_API_KEY=

# Database (local Postgres on the iMac)
DATABASE_URL=postgresql://localhost:5432/milmed

# Redis (local)
REDIS_URL=redis://localhost:6379

# Crawler behavior
MTEC_RATE_LIMIT_SECONDS=2
USER_AGENT=MILMED-Connect-Bot/0.1 (+https://github.com/seantei/milmed-connect)

# Alerts (optional)
# SLACK_WEBHOOK_URL=
# SMTP_HOST=
